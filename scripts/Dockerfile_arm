FROM tnh-base-arm

USER root
RUN useradd -ms /bin/bash webserver

ENV HOME=/home/webserver
ENV TNH_HOME=$HOME/tnh-http-server
ENV TNH_SETTINGS_JSON=$TNH_HOME/tnh_settings.json
ENV TNH_LOG=/var/opt/tnh-server
ENV TNH_EXEC=/usr/local/bin/tnh-server

RUN mkdir -p $TNH_LOG && chown webserver:webserver $TNH_LOG

# Build from local source (run: docker build -f scripts/Dockerfile_arm -t tnh-server .)
COPY --chown=webserver:webserver . $TNH_HOME
RUN wget -q -O $TNH_HOME/include/json.hpp \
        https://github.com/nlohmann/json/releases/download/v3.11.2/json.hpp && \
    mkdir -p $TNH_HOME/build && \
    cd $TNH_HOME/build && \
    cmake .. && \
    cmake --build . -j$(nproc) --target install

# Override settings after source copy (keeps credentials out of the image layer with source)
COPY --chown=webserver:webserver tnh_settings.json $TNH_SETTINGS_JSON

USER webserver
WORKDIR /home/webserver
CMD ["/usr/local/bin/tnh-server"]